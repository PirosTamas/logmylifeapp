CREATE TABLE workout_plan_exercise_cross_ref (
    planId INTEGER AS kotlin.Int NOT NULL,
    exerciseId INTEGER AS kotlin.Int NOT NULL,
    orderInWorkout INTEGER AS kotlin.Int NOT NULL,
    PRIMARY KEY (planId, exerciseId)
);

getAllWorkoutPlanExerciseCrossRefs:
SELECT * FROM workout_plan_exercise_cross_ref;

addWorkoutPlanExerciseCrossRef:
INSERT OR IGNORE INTO workout_plan_exercise_cross_ref (planId, exerciseId, orderInWorkout)
VALUES (:planId, :exerciseId, :orderInWorkout);

insertWorkoutPlanExerciseCrossRef:
INSERT OR REPLACE INTO workout_plan_exercise_cross_ref (planId, exerciseId, orderInWorkout)
VALUES (:planId, :exerciseId, :orderInWorkout);

updateWorkoutPlanExerciseCrossRef:
UPDATE workout_plan_exercise_cross_ref
SET orderInWorkout = :orderInWorkout
WHERE planId = :planId AND exerciseId = :exerciseId;

deleteWorkoutPlanExerciseCrossRef:
DELETE FROM workout_plan_exercise_cross_ref
WHERE planId = :planId AND exerciseId = :exerciseId;

getExerciseCountForWorkoutSession:
SELECT COUNT(*) FROM workout_plan_exercise_cross_ref
WHERE planId = (SELECT planId FROM workout_session WHERE id = :sessionId);
