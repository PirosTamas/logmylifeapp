CREATE TABLE workout_plan_stretch_cross_ref (
    planId INTEGER AS kotlin.Int NOT NULL,
    exerciseId INTEGER AS kotlin.Int NOT NULL,
    orderInStretch INTEGER AS kotlin.Int NOT NULL,
    PRIMARY KEY (planId, exerciseId)
);

addWorkoutPlanStretchCrossRef:
INSERT OR IGNORE INTO workout_plan_stretch_cross_ref (planId, exerciseId, orderInStretch)
VALUES (:planId, :exerciseId, :orderInStretch);

insertWorkoutPlanStretchCrossRef:
INSERT OR REPLACE INTO workout_plan_stretch_cross_ref (planId, exerciseId, orderInStretch)
VALUES (:planId, :exerciseId, :orderInStretch);

deleteWorkoutPlanStretchCrossRef:
DELETE FROM workout_plan_stretch_cross_ref
WHERE planId = :planId AND exerciseId = :exerciseId;

getStretchCountForSession:
SELECT COUNT(*) FROM workout_plan_stretch_cross_ref
WHERE planId = (SELECT planId FROM workout_session WHERE id = :sessionId);
