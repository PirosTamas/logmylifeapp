CREATE TABLE workout_exercise_log (
    id INTEGER AS kotlin.Int NOT NULL PRIMARY KEY AUTOINCREMENT,
    sessionId INTEGER AS kotlin.Int NOT NULL,
    exerciseId INTEGER AS kotlin.Int NOT NULL,
    FOREIGN KEY (sessionId) REFERENCES workout_session(id) ON DELETE CASCADE,
    FOREIGN KEY (exerciseId) REFERENCES workout_exercise(id) ON DELETE CASCADE
);

getAllWorkoutExerciseLogs:
SELECT * FROM workout_exercise_log;

getWorkoutExerciseLogById:
SELECT * FROM workout_exercise_log WHERE id = :id;

addWorkoutExerciseLog:
INSERT OR IGNORE INTO workout_exercise_log (sessionId, exerciseId)
VALUES (:sessionId, :exerciseId);

insertWorkoutExerciseLog:
INSERT OR REPLACE INTO workout_exercise_log (sessionId, exerciseId)
VALUES (:sessionId, :exerciseId);

updateWorkoutExerciseLog:
UPDATE workout_exercise_log
SET sessionId = :sessionId, exerciseId = :exerciseId
WHERE id = :id;

deleteWorkoutExerciseLog:
DELETE FROM workout_exercise_log WHERE id = :id;

getCurrentExerciseIndexBySessionId:
SELECT COUNT(*) FROM workout_exercise_log WHERE sessionId = :sessionId;

lastInsertRowId:
SELECT last_insert_rowid();
